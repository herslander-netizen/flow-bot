# Copie para .env e preencha. Nunca suba o .env para o Git.
# Gere cada segredo com: openssl rand -hex 32

# Endereço público HTTPS da Evolution (ex.: https://evolution.seudominio.com.br).
EVOLUTION_SERVER_URL=
# Chave da Evolution.
EVOLUTION_API_KEY=
# Senha do Postgres interno.
POSTGRES_PASSWORD=
# Segredo que a Evolution envia ao Flow Bot em cada aviso (32+ caracteres).
FLOW_BOT_WEBHOOK_SECRET=
# Segredo para contar pessoas no aprendizado sem guardar quem são.
FLOW_BOT_SEGREDO=
# Token que o Flow Bot envia ao Flow ao pedir a realidade (o Flow confere).
TOKEN_FLOW=
