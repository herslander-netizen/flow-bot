{
  "name": "@flow-bot/store-postgres",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "Persistência e execução durável do Flow Bot em Postgres: versões publicadas, sessões, eventos idempotentes, fila de prazos e caixa de saída.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
