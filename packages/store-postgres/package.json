      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@flow-bot/contracts": "0.0.0",
    "@flow-bot/runtime": "0.0.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
